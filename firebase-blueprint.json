{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string", "description": "Display name" },
        "email": { "type": "string", "format": "email", "description": "User email" },
        "photoURL": { "type": "string", "description": "Profile picture URL" },
        "role": { "type": "string", "enum": ["admin", "user"], "description": "User role" },
        "lastLogin": { "type": "string", "format": "date-time", "description": "Last login timestamp" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "LeaderboardEntry": {
      "title": "Leaderboard Entry",
      "description": "A single entry in the global leaderboard",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the user" },
        "name": { "type": "string", "description": "Display name of the user" },
        "score": { "type": "integer", "description": "The score achieved" },
        "timestamp": { "type": "string", "format": "date-time", "description": "When the score was achieved" }
      },
      "required": ["userId", "name", "score", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profiles"
    },
    "/leaderboard/{entryId}": {
      "schema": "LeaderboardEntry",
      "description": "Stores leaderboard entries"
    }
  }
}
